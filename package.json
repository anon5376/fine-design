{
  "name": "fine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4318",
    "tokens": "node scripts/tokens.mjs",
    "registry:build": "node scripts/registry.mjs && shadcn build",
    "build": "npm run tokens && npm run registry:build && next build",
    "typecheck": "tsc --noEmit",
    "check:snippets": "node scripts/check-snippets.mts",
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "verify": "npm run build && npm run typecheck && npm run check:snippets && npm test",
    "verify:install": "node scripts/verify-install.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
